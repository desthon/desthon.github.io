---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HydroEmblem from '../components/HydroEmblem.astro';
import GalleryGrid from '../components/GalleryGrid.astro';
import PostCard from '../components/PostCard.astro';
import { SITE, formatDate, readingTime } from '../consts';
import { GALLERY, HERO_SHOT } from '../data/gallery';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const featured = posts.filter((post) => post.data.featured).slice(0, 3);
const latest = posts.slice(0, 6);
const hasPosts = posts.length > 0;

const tagCounts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}
const tags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1]).slice(0, 14);
---
<BaseLayout description={SITE.description}>
  <section class="hero">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <span class="eyebrow hero-eyebrow">Personal Blog · 芙宁娜主题</span>
        <h1 class="hero-title">
          你好，我是<br />
          <span class="grad">desthon</span>
        </h1>
        <p class="hero-lead">
          这里是我的水边小屋：芙宁娜的相册、随手写下的字，和一些技术笔记。
          水会记得一切，所以我把它们都放进来了。
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/gallery/">
            看相册
            <span aria-hidden="true">→</span>
          </a>
          <a class="btn btn-ghost" href="/about/">关于我</a>
        </div>
        <div class="hero-meta">
          <span><i></i>{GALLERY.length} 张美图</span>
          <span><i></i>枫丹 · 水之记忆</span>
          <span><i></i>更新于 {posts[0] ? formatDate(posts[0].data.date) : '刚刚'}</span>
        </div>
      </div>

      <div class="emblem-wrap">
        <span class="bubble"></span>
        <span class="bubble"></span>
        <span class="bubble"></span>

        <figure class="portrait-card">
          <button
            class="portrait-open"
            type="button"
            data-lightbox
            data-src="/images/gallery/splash.webp"
            data-title={HERO_SHOT.title}
            data-caption="她举起权杖，法庭的灯亮了一半。"
            aria-label="查看芙宁娜立绘大图"
          >
            <img
              src={`/images/${HERO_SHOT.file}`}
              alt="芙宁娜角色立绘"
              width={HERO_SHOT.width}
              height={HERO_SHOT.height}
              fetchpriority="high"
              decoding="async"
            />
          </button>
          <figcaption>
            <span class="portrait-name">{HERO_SHOT.title}</span>
            <span class="portrait-note">{HERO_SHOT.note}</span>
          </figcaption>
          <span class="portrait-badge" aria-hidden="true">
            <HydroEmblem />
          </span>
        </figure>
      </div>
    </div>

    <div class="hero-waves" aria-hidden="true">
      <svg viewBox="0 0 1440 120" preserveAspectRatio="none">
        <path
          d="M0 62 C 180 18 300 104 480 72 S 780 8 960 52 S 1260 104 1440 58 V120 H0Z"
          fill="var(--pearl)" opacity=".3"></path>
        <path
          d="M0 90 C 200 58 340 122 520 98 S 820 58 1000 86 S 1300 120 1440 94 V120 H0Z"
          fill="var(--pearl)"></path>
      </svg>
    </div>
  </section>

  <div class="shell">
    <dl class="stats reveal">
      <div class="stat"><dt>相册</dt><dd>{GALLERY.length} 张</dd></div>
      <div class="stat"><dt>文章</dt><dd>{posts.length} 篇</dd></div>
      <div class="stat"><dt>主题</dt><dd>芙宁娜</dd></div>
      <div class="stat"><dt>坐标</dt><dd>枫丹 · 歌剧院</dd></div>
    </dl>
  </div>

  <section class="section shell">
    <div class="section-head reveal">
      <div>
        <span class="eyebrow">Gallery</span>
        <h2 class="section-title">水镜<em>相册</em></h2>
        <p class="section-sub">官方美术与壁纸，点开可看大图。</p>
      </div>
      <a class="link-more" href="/gallery/">全部 {GALLERY.length} 张 <span aria-hidden="true">→</span></a>
    </div>

    <div class="reveal">
      <GalleryGrid limit={6} />
    </div>
  </section>

  <section class="shell" style="padding-bottom: clamp(40px, 6vw, 72px)">
    <div class="banner-strip reveal">
      <img src="/images/banner.webp" alt="枫丹水面与芙宁娜的壁纸" loading="lazy" decoding="async" />
      <div class="banner-copy">
        <blockquote>水会记得一切。即使是那些你希望它忘记的。</blockquote>
        <cite>—— 芙宁娜 · 水神 / Focalors</cite>
      </div>
    </div>
  </section>

  <section class="section shell" style="padding-top:0">
    <div class="section-head reveal">
      <div>
        <span class="eyebrow">Writing</span>
        <h2 class="section-title">随手<em>写写</em></h2>
      </div>
      {hasPosts && <a class="link-more" href="/posts/">全部文章 <span aria-hidden="true">→</span></a>}
    </div>

    {hasPosts ? (
      <>
        {featured.length > 0 && (
          <div class="card-grid" style="margin-bottom:24px">
            {featured.map((post) => <PostCard post={post} />)}
          </div>
        )}
        <ul class="post-list reveal">
          {latest.map((post) => (
            <li>
              <a class="post-row" href={`/posts/${post.id}/`}>
                <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                <strong>{post.data.title}</strong>
                <span class="row-meta">
                  {post.data.tags[0] ?? '随笔'} · {readingTime(post.body ?? '')} 分钟
                </span>
              </a>
            </li>
          ))}
        </ul>
      </>
    ) : (
      <div class="empty-state reveal">
        <svg viewBox="0 0 64 64" aria-hidden="true">
          <path d="M32 6c8 10.6 15 17.6 15 25.4a15 15 0 0 1-30 0C17 23.6 24 16.6 32 6z"
            fill="none" stroke="currentColor" stroke-width="1.6"></path>
          <path d="M32 20c4.6 6 8 9.8 8 14.2a8 8 0 0 1-16 0c0-4.4 3.4-8.2 8-14.2z"
            fill="currentColor" opacity=".35"></path>
        </svg>
        <h3>还没有文章</h3>
        <p>相册已经先搬进来了。文字还在水里，等它浮上来。</p>
        <a class="btn btn-primary" href="/gallery/">先去看图 <span aria-hidden="true">→</span></a>
      </div>
    )}
  </section>

  {tags.length > 0 && (
    <section class="section shell" style="padding-top:0">
      <div class="section-head reveal">
        <div>
          <span class="eyebrow">Tags</span>
          <h2 class="section-title">按<em>水纹</em>分类</h2>
        </div>
        <a class="link-more" href="/tags/">全部标签 <span aria-hidden="true">→</span></a>
      </div>
      <div class="tag-cloud reveal">
        {tags.map(([tag, count]) => (
          <a href={`/tags/${encodeURIComponent(tag)}/`}>{tag} <var>{count}</var></a>
        ))}
      </div>
    </section>
  )}
</BaseLayout>
