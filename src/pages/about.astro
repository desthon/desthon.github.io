---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';

const profile = [
  ['名字', '芙宁娜 / Furina'],
  ['别称', '水神 · Focalors'],
  ['地区', '枫丹 · 歌剧院'],
  ['元素', '水 / Hydro'],
  ['身份', '审判官 · 演员 · 神明（兼职）'],
  ['喜好', '甜点、红茶、掌声'],
  ['信条', '水会记得一切'],
];

const host = [
  ['站主', SITE.author],
  ['框架', 'Astro（静态站点）'],
  ['内容', 'Markdown + 内容集合'],
  ['托管', 'GitHub Pages'],
  ['样式', '手写 CSS，无 UI 框架'],
];
---
<BaseLayout title="关于" description="关于这座花园、它为什么是蓝色的，以及站主是谁。">
  <section class="article-hero">
    <div class="shell">
      <div class="inner">
        <span class="eyebrow">About</span>
        <h1 class="article-title" style="margin-top:14px">关于这座花园</h1>
        <p class="article-desc">
          一座以芙宁娜为主题的私人博客。它不追热点，不接广告，不做统计，只负责把一些字留在水里。
        </p>
      </div>
    </div>
  </section>

  <div class="shell article-layout">
    <div class="prose">
      <h2>为什么是芙宁娜</h2>
      <p>
        因为她是我见过最"不像神"的神。她会紧张、会逞强、会在深夜里偷偷一个人待着，
        却又把一件几乎不可能的事坚持了五百年。喜欢她，不是喜欢一个完美的偶像，
        而是喜欢一种"明知会疼还继续"的姿态。
      </p>

      <h2>这里写什么</h2>
      <ul>
        <li><strong>剧情考据</strong>：枫丹的世界观、审判制度、水的隐喻。</li>
        <li><strong>随笔</strong>：一些跟角色有关、但其实在写自己的东西。</li>
        <li><strong>设计笔记</strong>：这个站长成这样，是有理由的。</li>
      </ul>

      <h2>视觉怎么来的</h2>
      <p>
        主色只有四个：珍珠白、法庭深蓝、水元素青、金饰。金色面积永远不超过百分之三，
        因为它只是灯光，不是墙面。中文标题用霞鹜文楷，正文用系统无衬线，
        让页面像一页被水泡过的纸，而不是一张幻灯片。
      </p>

      <blockquote>
        <p>「我不需要所有人理解我。我只需要，明天还能站上那个位置。」</p>
      </blockquote>

      <h2>关于技术</h2>
      <p>
        全站是纯静态的：Markdown 写作，Astro 构建，产物是一堆 HTML，
        扔到任何一台服务器都能跑。没有数据库，没有后端，没有第三方统计。
        你想读就走 <a href="/rss.xml">RSS</a>，数据在你自己手里。
      </p>

      <h2>联系</h2>
      <p>
        可以在 <a href="https://github.com/desthon" rel="noopener">GitHub</a> 上找到我。
        不设评论区，是因为我相信真正想说话的人，会自己找到路。
      </p>
    </div>

    <aside class="aside-card">
      <div class="profile-card">
        <div class="name">芙宁娜</div>
        <div class="sub">Furina · Hydro Archon</div>
        <dl>
          {profile.map(([key, value]) => (
            <>
              <dt>{key}</dt>
              <dd>{value}</dd>
            </>
          ))}
        </dl>
      </div>

      <div class="profile-card">
        <div class="sub" style="margin-bottom:16px">Site</div>
        <dl>
          {host.map(([key, value]) => (
            <>
              <dt>{key}</dt>
              <dd>{value}</dd>
            </>
          ))}
        </dl>
      </div>
    </aside>
  </div>
</BaseLayout>
