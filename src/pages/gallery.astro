---
import BaseLayout from '../layouts/BaseLayout.astro';
import GalleryGrid from '../components/GalleryGrid.astro';
import { CATEGORIES, GALLERY } from '../data/gallery';
import { CREDIT } from '../consts';
---
<BaseLayout title="相册" description="芙宁娜的官方美术与米游社同人作品：立绘、卡面、壁纸、纪念绘与同人图。">
  <section class="article-hero">
    <div class="shell">
      <div class="inner">
        <span class="eyebrow">Gallery</span>
        <h1 class="article-title" style="margin-top:14px">水镜相册</h1>
        <p class="article-desc">
          {GALLERY.length} 张芙宁娜的图：官方立绘、卡面、壁纸、纪念绘，以及米游社同人作品。
          点任意一张可以看大图，支持左右方向键与触屏滑动。
        </p>
        <p class="article-meta" style="max-width:44rem">{CREDIT}</p>
        <p class="article-meta" style="max-width:44rem">
          同人图源：
          <a href="https://www.miyoushe.com/ys/article/64072596" rel="noopener">米游社 @丶柯</a> ·
          <a href="https://www.miyoushe.com/ys/article/67763622" rel="noopener">米游社 @云堂主</a>
        </p>
      </div>
    </div>
  </section>

  <div class="shell gallery-wrap">
    <div class="filter-bar" role="group" aria-label="按类型筛选">
      <button class="filter-chip is-active" type="button" data-filter="all">全部</button>
      {CATEGORIES.map((cat) => (
        <button class="filter-chip" type="button" data-filter={cat}>{cat}</button>
      ))}
    </div>

    <GalleryGrid />
    <p class="gallery-empty" hidden>这个分类下暂时没有图片。</p>
  </div>

  <script>
    const chips = [...document.querySelectorAll<HTMLButtonElement>('.filter-chip')];
    const shots = [...document.querySelectorAll<HTMLElement>('.shot')];
    const empty = document.querySelector<HTMLElement>('.gallery-empty');

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const cat = chip.dataset.filter ?? 'all';
        chips.forEach((c) => c.classList.toggle('is-active', c === chip));
        let visible = 0;
        shots.forEach((shot) => {
          const show = cat === 'all' || shot.dataset.cat === cat;
          shot.hidden = !show;
          if (show) visible += 1;
        });
        if (empty) empty.hidden = visible > 0;
      });
    });
  </script>
</BaseLayout>
