---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="页面走失了" description="404：这一页被水流带走了。">
  <div class="shell notfound">
    <div class="code">404</div>
    <h1 class="section-title">这一页被水流带走了</h1>
    <p class="section-sub">也许它换了名字，也许它从来只存在于我的草稿里。</p>
    <div class="hero-actions" style="margin-top:8px">
      <a class="btn btn-primary" href="/" style="background:linear-gradient(120deg,#2f86c9,#7fd8ec);color:#fff">
        回到首页
      </a>
      <a class="btn btn-ghost" href="/posts/" style="border-color:var(--line-strong);color:var(--ink-2);background:var(--surface)">
        翻翻文集
      </a>
    </div>
  </div>
</BaseLayout>
