---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, readingTime } from '../../consts';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const byYear = new Map<number, typeof posts>();
for (const post of posts) {
  const year = post.data.date.getFullYear();
  const bucket = byYear.get(year) ?? [];
  bucket.push(post);
  byYear.set(year, bucket);
}
const years = [...byYear.entries()].sort((a, b) => b[0] - a[0]);
---
<BaseLayout title="文章" description="按年份归档的全部文章：随笔与技术笔记。">
  <section class="article-hero">
    <div class="shell">
      <div class="inner">
        <span class="eyebrow">Archive</span>
        <h1 class="article-title" style="margin-top:14px">文章</h1>
        <p class="article-desc">
          共 {posts.length} 篇，按时间从新到旧。
        </p>
      </div>
    </div>
  </section>

  <div class="shell" style="padding-block: clamp(40px, 6vw, 64px)">
    {years.length === 0 && (
      <div class="empty-state">
        <svg viewBox="0 0 64 64" aria-hidden="true">
          <path d="M32 6c8 10.6 15 17.6 15 25.4a15 15 0 0 1-30 0C17 23.6 24 16.6 32 6z"
            fill="none" stroke="currentColor" stroke-width="1.6"></path>
          <path d="M32 20c4.6 6 8 9.8 8 14.2a8 8 0 0 1-16 0c0-4.4 3.4-8.2 8-14.2z"
            fill="currentColor" opacity=".35"></path>
        </svg>
        <h3>文集还是空的</h3>
        <p>示例文章已全部清空，这里等着你写第一篇。</p>
        <a class="btn btn-primary" href="/gallery/">先去看图 <span aria-hidden="true">→</span></a>
      </div>
    )}

    {years.map(([year, items]) => (
      <div class="year-block reveal">
        <h2 class="year-label">{year}</h2>
        <ul class="post-list">
          {items.map((post) => (
            <li>
              <a class="post-row" href={`/posts/${post.id}/`}>
                <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                <strong>{post.data.title}</strong>
                <span class="row-meta">
                  {post.data.tags.join(' / ')} · {readingTime(post.body ?? '')} 分钟
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</BaseLayout>
